{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SemanticDataCharter/sdcreceipt-ts",
  "description": "Verify VSL Settlement Receipts and sign triggers in TypeScript, conforming to sdcreceipt.",
  "repository": {
    "url": "https://github.com/SemanticDataCharter/sdcreceipt-ts",
    "source": "github"
  },
  "version": "4.0.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "sdcreceipt-ts",
      "version": "4.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "description": "Run the MCP stdio server."
        }
      ]
    }
  ]
}
